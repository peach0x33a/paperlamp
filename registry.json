      "css": {
        "@keyframes fade-up": {
          "from": {
            "opacity": "0",
            "transform": "translateY(10px)"
          }
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "html": {
            "color-scheme": "light"
          },
          "html.dark": {
            "color-scheme": "dark"
          },
          "body": {
            "@apply bg-background text-foreground font-sans antialiased": {},
            "transition": "background-color var(--motion-theme) ease, color var(--motion-theme) ease"
          },
          "::selection": {
            "background": "var(--foreground)",
            "color": "var(--background)"
          }
        },
        "@utility headline-xl": {
          "font-family": "var(--font-serif)",
          "font-size": "2.25rem",
          "font-weight": "700",
          "line-height": "1.2",
          "letter-spacing": "0em"
        },
        "@utility headline-lg": {
          "font-family": "var(--font-serif)",
          "font-size": "1.875rem",
          "font-weight": "700",
          "line-height": "1.2",
          "letter-spacing": "0em"
        },
        "@utility headline-md": {
          "font-family": "var(--font-serif)",
          "font-size": "1.5rem",
          "font-weight": "700",
          "line-height": "1.25",
          "letter-spacing": "0em"
        },
        "@utility title-md": {
          "font-family": "var(--font-serif)",
          "font-size": "1.25rem",
          "font-weight": "700",
          "line-height": "1.35",
          "letter-spacing": "0em"
        },
        "@utility body-md": {
          "font-family": "var(--font-serif)",
          "font-size": "1rem",
          "font-weight": "400",
          "line-height": "1.7",
          "letter-spacing": "0em"
        },
        "@utility body-sm": {
          "font-family": "var(--font-serif)",
          "font-size": "0.875rem",
          "font-weight": "400",
          "line-height": "1.6",
          "letter-spacing": "0em"
        },
        "@utility label-md": {
