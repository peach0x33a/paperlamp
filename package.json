{
  "name": "paperlamp-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "纸灯 / Paperlamp — a Vue 3 component library and docs site generated from DESIGN.md (google-labs-code/design.md)",
  "license": "MIT",
  "scripts": {
    "dev": "bun run build:tokens && bun run build:registry && vite --host",
    "build": "bun run build:tokens && bun run build:registry && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build:tokens": "bun scripts/build-tokens.ts",
    "build:registry": "bun scripts/build-registry.ts",
    "lint": "designmd lint DESIGN.md",
    "diff": "designmd diff",
    "export:tailwind": "designmd export --format json-tailwind DESIGN.md",
    "export:css": "designmd export --format css-tailwind DESIGN.md",
    "export:dtcg": "designmd export --format dtcg DESIGN.md",
    "spec": "designmd spec --rules",
    "build:cli": "cd packages/cli && bun run build"
  },
  "devDependencies": {
    "@google/design.md": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/vue-table": "^9.3.1",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^1.0.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  }
}
