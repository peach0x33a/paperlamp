{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["registry/ui/*"],
      "@/lib/*": ["registry/lib/*"],
      "@/styles/*": ["registry/styles/*"],
      "@docs/*": ["www/src/*"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.vue", "www/src/**/*.ts", "www/src/**/*.vue"]
}
